---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import TopBar from '../components/TopBar.astro';
import ComponentGrid from '../components/ComponentGrid.tsx';
import SearchModal from '../components/SearchModal.tsx';
import CartSidebar from '../components/CartSidebar.tsx';
import HomeStats from '../components/HomeStats.tsx';

import fs from 'node:fs';
import path from 'node:path';
import { totalComponents } from '../lib/agent-readiness';

export const prerender = true;

let total = 2000;
try {
  total = totalComponents(JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'counts.json'), 'utf-8')));
} catch {}
---

<DashboardLayout
  title="Hivework: Autonomous AI Workforce Platform & Components"
  description="Browse and install components for AI workforce and Claude Code. AI agents, slash commands, MCP integrations, hooks, and settings."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Hivework",
    "description": "Autonomous AI workforce platform and component ecosystem. Over 1,000 pre-built agents, commands, skills, settings, hooks, and MCP integrations.",
    "url": "https://github.com/allanindrajith/Hivework",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows, macOS, Linux",
    "author": { "@id": "https://github.com/allanindrajith/Hivework#organization" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "softwareRequirements": "Node.js 18+, Claude Code CLI",
    "license": "https://opensource.org/licenses/MIT"
  })} />
  <TopBar />

  <!-- Main content -->
  <div class="min-h-0">
    <div class="w-full min-w-0">
      <!-- ASCII hero banner -->
      <div class="px-4 sm:px-6 pt-4 sm:pt-5 pb-1">
        <div class="hidden md:flex items-center justify-center gap-4 overflow-hidden">
          <pre class="ascii-art shrink-0" aria-hidden="true">
██╗  ██╗██╗██╗   ██╗███████╗██╗    ██╗ ██████╗ ██████╗ ██╗  ██╗
██║  ██║██║██║   ██║██╔════╝██║    ██║██╔═══██╗██╔══██╗██║ ██╔╝
███████║██║██║   ██║█████╗  ██║ █╗ ██║██║   ██║██████╔╝█████╔╝ 
██╔══██║██║╚██╗ ██╔╝██╔══╝  ██║███╗██║██║   ██║██╔══██╗██╔═██╗ 
██║  ██║██║ ╚████╔╝ ███████╗╚███╔███╔╝╚██████╔╝██║  ██║██║  ██╗
╚═╝  ╚═╝╚═╝  ╚═══╝  ╚══════╝ ╚══╝╚══╝  ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝</pre>
          <svg class="w-16 h-16 shrink-0" viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <path d="M60 12 L102 36 V84 L60 108 L18 84 V36 Z" stroke="var(--color-accent, #f59e0b)" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"/>
            <path d="M40 36 V48 L60 62 L80 48 V36" stroke="var(--color-accent, #f59e0b)" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"/>
            <path d="M60 62 V88" stroke="var(--color-accent, #f59e0b)" stroke-width="8" stroke-linecap="round"/>
            <circle cx="60" cy="93" r="5" fill="var(--color-accent, #f59e0b)"/>
          </svg>
        </div>
        <div class="flex items-center justify-center gap-2 mt-2 mb-1">
          <span class="status-dot"></span>
          <h1 class="font-ui-mono text-[12px] font-normal text-[var(--color-text-secondary)]"><span class="sr-only">Hivework: </span>Ready-to-use configurations for your AI workforce</h1>
        </div>
        <HomeStats client:load />
      </div>

      {/* <FeaturedSection /> */}
      <ComponentGrid client:load initialType="skills" />

      <!-- Plain-HTML summary: readable without JavaScript (agents, crawlers, no-JS browsers) -->
      <section class="px-6 pt-10 pb-2 max-w-3xl text-[13px] leading-relaxed text-[var(--color-text-secondary)]">
        <h2 class="text-[14px] font-semibold text-[var(--color-text-primary)] mb-2">What is Hivework?</h2>
        <p class="mb-2">
          Hivework is an open-source catalog of {total.toLocaleString('en-US')}+ components for
          AI agents and developers: subagents, slash commands, skills, hooks, MCP server configurations, settings, loops and mods.
          Every component is a plain file you can read before installing, with its source on
          <a href="https://github.com/allanindrajith/Hivework" class="underline hover:text-[var(--color-text-primary)]">GitHub</a>.
        </p>
        <p>
          AI agents can start from <a href="/llms.txt" class="underline hover:text-[var(--color-text-primary)]">/llms.txt</a>
          and the catalog data API described in <a href="/openapi.json" class="underline hover:text-[var(--color-text-primary)]">/openapi.json</a>.
        </p>
      </section>
    </div>
  </div>
  <SearchModal client:idle />
  <CartSidebar client:idle />
</DashboardLayout>
