{
  "name": "hivework-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-catalog.mjs",
    "sync:desktop": "node scripts/sync-catalog.mjs --with-desktop",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "deploy": "npm test && npm run build && rsync -avz --delete --exclude='.well-known' --exclude='cgi-bin' dist/ cpanel:~/hivework.online/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  }
}
